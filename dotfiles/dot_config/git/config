## https://git-scm.com/docs/git-config

[branch]
	sort = -committerdate

[core]
	editor = zed --wait

[credential]
	helper = libsecret

[fetch]
	all = true
	prune = true

[init]
	defaultBranch = main

[merge]
	conflictStyle = zdiff3

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[rerere]
	enabled = true

[user]
	email = alexelizard@gmail.com
	name = Aleksei Bibus

[includeIf "hasconfig:remote.*.url:*.dns-shop.ru*/**"]
	path = ~/.config/git/overrides/dns-shop
