// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Git",
    "command": "ghostty -e lazygit -p $ZED_WORKTREE_ROOT",
    "hide": "on_success",
  },
  {
    "label": "Hard reset to $ZED_GIT_SHA_SHORT",
    "command": "git",
    "args": ["reset", "--hard", "$ZED_GIT_SHA"],
    "tags": ["git-command"],
  },
  {
    "label": "Soft reset to $ZED_GIT_SHA_SHORT",
    "command": "git",
    "args": ["reset", "--soft", "$ZED_GIT_SHA"],
    "tags": ["git-command"],
  },
]
