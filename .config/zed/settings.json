// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "effort": "xhigh",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "max",
        "mode": "plan",
        "model": "opus",
      },
      "type": "registry",
    },
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "git-firefly": true,
    "html": true,
    "lua": true,
    "sql": true,
    "toml": true,
  },
  "context_servers": {
    "mise": {
      "enabled": true,
      "remote": false,
      "command": "mise",
      "args": ["mcp"],
      "env": {
        "MISE_EXPERIMENTAL": "1",
      },
    },
  },
  "format_on_save": "on",
  "git_panel": {
    "tree_view": true,
  },
  "git_hosting_providers": [
    {
      "provider": "gitlab",
      "name": "DNS Tech",
      "base_url": "https://adm-dwh-git.dns-shop.ru",
    },
  ],
  // https://zed.dev/docs/configuring-languages#choosing-language-servers
  "languages": {
    "Python": {
      "language_servers": ["ruff", "ty"],
    },
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemas": {
            "https://squidfunk.github.io/mkdocs-material/schema.json": [
              "**/mkdocs.yml",
            ],
            "https://taskfile.dev/schema.json": [
              "**/Taskfile.yml",
              "**/taskfile.yml",
              "**/Taskfile.yaml",
              "**/taskfile.yaml",
              "**/Taskfile.dist.yml",
              "**/taskfile.dist.yml",
              "**/Taskfile.dist.yaml",
              "**/taskfile.dist.yaml",
              // Custom directory
              "**/taskfiles/*.yaml",
            ],
          },
        },
      },
    },
  },
  "ssh_connections": [
    {
      "host": "unraid.local",
      "username": "root",
      "projects": [{ "paths": ["/mnt/user/appdata"] }],
    },
  ],
  "terminal": {
    "shell": {
      "program": "fish",
    },
  },
  "vim_mode": false,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
}
