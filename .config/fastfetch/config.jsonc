{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "key": {
      "width": 22,
    },
  },
  "modules": [
    // --- Device: статичные характеристики железа ---
    {
      "type": "host",
      "key": "{icon} Device",
      "keyColor": "red",
    },
    {
      "type": "cpu",
      "key": "│ ├{icon} CPU",
      "keyColor": "red",
    },
    {
      "type": "gpu",
      "key": "│ ├{icon} GPU",
      "keyColor": "red",
    },
    {
      "type": "sound",
      "key": "│ ├{icon} Sound",
      "keyColor": "red",
    },
    {
      "type": "display",
      "key": "│ ├{icon} Display",
      "keyColor": "red",
    },
    {
      "type": "bluetooth",
      "key": "│ └{icon} Bluetooth",
      "keyColor": "red",
    },

    // --- Resources: текущая нагрузка, с полосой загрузки ---
    {
      "type": "custom",
      "key": "󰊚 Resources",
      "keyColor": "cyan",
    },
    {
      "type": "battery",
      "key": "│ ├{icon} Battery",
      "keyColor": "cyan",
      // green > yellow -> шкала работает в обратную сторону: полный заряд зелёный, низкий красный
      "percent": {
        "type": ["bar", "bar-monochrome", "num", "num-color"],
        "green": 80,
        "yellow": 20,
      },
    },
    {
      "type": "memory",
      "key": "│ ├󰑭 RAM",
      "keyColor": "cyan",
      "percent": {
        "type": ["bar", "bar-monochrome", "num", "num-color"],
        "green": 50,
        "yellow": 80,
      },
    },
    {
      "type": "swap",
      "key": "│ ├{icon} Swap",
      "keyColor": "cyan",
      "percent": {
        "type": ["bar", "bar-monochrome", "num", "num-color"],
        "green": 50,
        "yellow": 80,
      },
    },
    {
      "type": "disk",
      "key": "│ └󰋊 Storage",
      "keyColor": "cyan",
      "percent": {
        "type": ["bar", "bar-monochrome", "num", "num-color"],
        "green": 50,
        "yellow": 80,
      },
    },
    {
      "type": "os",
      "key": "{icon} OS",
      "keyColor": "yellow",
    },
    {
      "type": "kernel",
      "key": "│ ├{icon} Kernel",
      "keyColor": "yellow",
    },
    {
      "type": "packages",
      "key": "│ ├{icon} Packages",
      "keyColor": "yellow",
    },
    {
      "type": "locale",
      "key": "│ ├󰗊 Locale",
      "keyColor": "yellow",
    },
    {
      "type": "uptime",
      "key": "│ ├{icon} Uptime",
      "keyColor": "yellow",
    },
    {
      "type": "localip",
      "key": "│ ├{icon} Local IP",
      "keyColor": "yellow",
    },
    {
      "type": "command",
      "key": "│ └󱦟 Age",
      "keyColor": "yellow",
      "text": "b=$(stat -c %W / 2>/dev/null); if [ -z $b ] || [ $b = 0 ]; then echo unknown; else echo $(( ($(date +%s) - b) / 86400 )) days; fi",
    },

    {
      "type": "terminal",
      "key": "{icon} Terminal",
      "keyColor": "blue",
    },
    {
      "type": "shell",
      "key": "│ ├{icon} Shell",
      "keyColor": "blue",
    },
    {
      "type": "terminaltheme",
      "key": "│ ├{icon} Theme",
      "keyColor": "blue",
    },
    {
      "type": "terminalfont",
      "key": "│ └{icon} Font",
      "keyColor": "blue",
    },

    {
      "type": "de",
      "key": "{icon} DE",
      "keyColor": "green",
    },
    {
      "type": "lm",
      "key": "│ ├󰍁 Login Manager",
      "keyColor": "green",
    },
    {
      "type": "wm",
      "key": "│ ├󰕮 Window Manager",
      "keyColor": "green",
    },
    {
      "type": "wmtheme",
      "key": "│ ├{icon} WM Theme",
      "keyColor": "magenta",
    },
    {
      "type": "theme",
      "key": "│ ├{icon} Theme",
      "keyColor": "magenta",
    },
    {
      "type": "icons",
      "key": "│ ├{icon} Icons",
      "keyColor": "magenta",
    },
    {
      "type": "font",
      "key": "│ ├{icon} Font",
      "keyColor": "magenta",
    },
    {
      "type": "cursor",
      "key": "│ └{icon} Cursor",
      "keyColor": "magenta",
    },
    "break",
    "colors",
  ],
}
